diff --git a/pkg/sql/opt/norm/factory.go b/pkg/sql/opt/norm/factory.go
index c098b8ae..78dce388 100644
--- a/pkg/sql/opt/norm/factory.go
+++ b/pkg/sql/opt/norm/factory.go
@@ -27,6 +27,22 @@ import (
 	"github.com/cockroachdb/redact"
 )
 
+// ExternalRule is a normalization rule that is not generated by optgen.
+// Apply reports whether the rule rewrote e, and if so the replacement, which
+// must have the same output columns as e.
+type ExternalRule interface {
+	Apply(f *Factory, e memo.RelExpr) (memo.RelExpr, bool)
+}
+
+var defaultExternalRules []func() ExternalRule
+
+// RegisterExternalRules registers a constructor for external rules that every
+// Factory installs when it is initialized. It must be called before any
+// Factory is used, typically from an init function.
+func RegisterExternalRules(newRules func() ExternalRule) {
+	defaultExternalRules = append(defaultExternalRules, newRules)
+}
+
 // ReplaceFunc is the callback function passed to the Factory.Replace method.
 // It is called with each child of the expression passed to Replace. See the
 // Replace method for more details.
@@ -86,6 +102,11 @@ type Factory struct {
 	// NotifyOnAppliedRule method.
 	appliedRule AppliedRuleFunc
 
+	// externalRules are rewrite rules defined outside of optgen. They are tried
+	// on each newly constructed relational expression, after the generated
+	// normalization rules.
+	externalRules []ExternalRule
+
 	// catalog is the opt catalog, used to resolve names during constant folding
 	// of special metadata queries like 'table_name'::regclass.
 	catalog cat.Catalog
@@ -146,6 +167,9 @@ func (f *Factory) Init(ctx context.Context, evalCtx *eval.Context, catalog cat.C
 
 	f.funcs.Init(f)
 	f.foldingControl.DisallowStableFolds()
+	for _, newRules := range defaultExternalRules {
+		f.externalRules = append(f.externalRules, newRules())
+	}
 }
 
 // FoldingControl returns the FoldingControl instance for this factory.
@@ -232,6 +256,12 @@ func (f *Factory) NotifyOnAppliedRule(appliedRule AppliedRuleFunc) {
 	f.appliedRule = appliedRule
 }
 
+// AddExternalRules registers rules to be tried on every constructed relational
+// expression.
+func (f *Factory) AddExternalRules(rules ...ExternalRule) {
+	f.externalRules = append(f.externalRules, rules...)
+}
+
 // SetDisabledRules is used to prevent normalization rule cycles when rules are
 // disabled during testing. SetDisabledRules does not prevent rules from
 // matching - rather, it notifies the Factory that rules have been prevented
@@ -449,6 +479,18 @@ func (f *Factory) onMaxConstructorStackDepthExceeded() {
 // constructs a relational expression, so that any custom manual pattern
 // matching/replacement code can be run.
 func (f *Factory) onConstructRelational(rel memo.RelExpr) memo.RelExpr {
+	for _, rule := range f.externalRules {
+		if f.matchedRule != nil && !f.matchedRule(opt.ExternalNormalizeRule) {
+			break
+		}
+		if out, ok := rule.Apply(f, rel); ok {
+			if f.appliedRule != nil {
+				f.appliedRule(opt.ExternalNormalizeRule, rel, out)
+			}
+			return out
+		}
+	}
+
